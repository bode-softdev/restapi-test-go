# Salin ke .env lalu sesuaikan. Jangan pernah commit .env yang berisi secret asli.

APP_PORT=8080
GIN_MODE=release

POSTGRES_USER=restapi
POSTGRES_PASSWORD=restapi
POSTGRES_DB=restapi
POSTGRES_PORT=5432

# Wajib, minimal 32 karakter. Hasilkan dengan: openssl rand -base64 48
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter-panjang-sekali

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=10

# Retry koneksi database saat start
CONNECT_ATTEMPTS=30
CONNECT_BACKOFF=1s

# Untuk mode lokal (tanpa docker) dan test integrasi
# DATABASE_URL=postgres://restapi:restapi@localhost:5432/restapi?sslmode=disable

# Test integrasi
# TEST_DATABASE_URL=postgres://restapi:restapi@localhost:5432/restapi_test?sslmode=disable
